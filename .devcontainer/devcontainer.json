{
  "name": "Hot100 Judge Safe",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends gcc g++ && node scripts/test-judge.js",
  "postStartCommand": "bash .devcontainer/start-private.sh",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Hot100 Judge",
      "onAutoForward": "openBrowser"
    }
  }
}
